# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,html,scss,css,json}]
indent_style = space
indent_size = 2
charset = utf-8

[*.{cs,csproj,sln}]
indent_style = space
indent_size = 4
charset = utf-8