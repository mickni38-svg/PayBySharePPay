<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath: self-contained .exe — kræver AspNetCoreModuleV2 på IIS-serveren -->
      <aspNetCore processPath=".\Api.PayBySharePay.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Simply" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
